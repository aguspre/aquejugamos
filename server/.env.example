# Base de datos PostgreSQL
DATABASE_URL="postgresql://aquejugamos:aquejugamos_dev@localhost:5432/aquejugamos?schema=public"

# Servidor
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Autenticación
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="7d"

# Firebase Admin SDK
# Opción 1 (desarrollo local): ruta al archivo serviceAccountKey.json descargado de Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"
# Opción 2 (producción / CI): credenciales por variables de entorno
FIREBASE_PROJECT_ID="aquejugamos-81425"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Google OAuth (opcional - legacy)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# BoardGameGeek XML API2 (opcional: bearer token si aplica)
BGG_API_BASE_URL="https://boardgamegeek.com/xmlapi2"
BGG_API_TOKEN=""
BGG_CACHE_TTL_DAYS=7
BGG_MAX_SYNCS_PER_DAY=2
BGG_SYNC_SAME_USER_COOLDOWN_MINUTES=5
BGG_SEARCH_RATE_LIMIT_PER_MIN=15
BGG_IMPORT_RATE_LIMIT_PER_HOUR=30
BGG_SEARCH_CACHE_TTL_MINUTES=15
BGG_MIN_FORCE_REFRESH_HOURS=24
BGG_MAX_COLLECTION_ITEMS=1500
BGG_REQUEST_TIMEOUT_MS=15000
